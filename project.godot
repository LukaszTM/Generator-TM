; Engine configuration file.
; It's best edited using the editor UI and not directly,
; since the parameters that go here are not all obvious.

config_version=5

[application]

config/name="Generator TM"
config/description="Generator planów testów i przypadków testowych z analizą dokumentacji i wyborem modułów."
run/main_scene="res://scenes/Main.tscn"
config/features=PackedStringArray("4.4")
config/icon="res://icon.svg"

[display]

window/size/viewport_width=1360
window/size/viewport_height=820
window/size/min_width=1024
window/size/min_height=640
window/stretch/mode="disabled"

[gui]

theme/default_font_antialiasing=1
theme/default_font_hinting=1

[rendering]

renderer/rendering_method="gl_compatibility"
renderer/rendering_method.mobile="gl_compatibility"
